# Managed Postgres — durable truth: committed strokes, the compaction cursor,
# and packed board snapshots.
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5432/whiteboard

# Managed Valkey (Redis protocol) — the per-board op stream, live cursors,
# presence, the leader lease and the replica roster.
REDIS_URL=redis://localhost:6379

PORT=3000

# Identifies this replica. On Brainpod the pod's hostname is already unique,
# so leaving these unset is the normal case; they exist for local clusters.
# POD_ID=local-1
# RELEASE_ID=dev

# Shown in the corner badge.
REGION=eu-west-1

# Set to 0 when nothing trustworthy sets X-Forwarded-For in front of the app.
TRUST_PROXY=1

# Abuse limits. The board is public and anyone may rub out anyone's stroke, so
# these exist to stop a script wiping it, not to stop a person erasing.
# OPS_PER_SECOND=120
# ERASES_PER_10S=60
